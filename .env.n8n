# Modo "n8n": el sitio local usa el backend real en n8n Cloud en lugar del simulador (server.js).
#   npm run dev:n8n   → http://localhost:5173 contra https://pansaloca.app.n8n.cloud
# Se suma a .env (la clave del asistente sigue saliendo de ahí). Solo contiene la URL pública de los webhooks.
VITE_API_URL=https://pansaloca.app.n8n.cloud/webhook
