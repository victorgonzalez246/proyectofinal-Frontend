# ── Servidor simulado (server.js) ──
# Webhooks de n8n. Vacío = desactivado.
# Nueva cita desde la landing (evento appointment.created)
N8N_APPOINTMENT_WEBHOOK=
# Envío del enlace mágico por WhatsApp (evento auth.magic_link).
# Sin este webhook, el enlace se muestra en pantalla y en consola (solo desarrollo).
N8N_AUTH_WEBHOOK=
# Alertas a la clínica: check-in preocupante y línea de tranquilidad (checkin.alert, sos.triggered)
N8N_ALERTS_WEBHOOK=
# URL pública del frontend, usada para construir el enlace mágico
PORTAL_URL=http://localhost:5173
# Orígenes del frontend autorizados (CORS), separados por coma
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Frontend (Vite) ──
# También se inserta en el Content-Security-Policy de index.html
VITE_API_URL=http://localhost:3001
