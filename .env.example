# ── Servidor simulado (server.js) ──
# Secreto compartido con n8n (encabezado X-N8N-Secret en ambos sentidos).
# Genera uno largo, p. ej.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_SHARED_SECRET=

# Firma de las sesiones (tokens HMAC, sin almacenamiento). Otro valor largo y distinto al anterior.
# En producción es el campo sessionSecret del nodo "Configuración API" en n8n.
SESSION_SECRET=

# Webhook único del cerebro maestro de n8n (Production URL del nodo "Webhook clínica").
# Recibe citas, acceso por WhatsApp y alertas. Vacío = desactivado; entonces el enlace
# mágico se muestra en pantalla y en consola (solo desarrollo).
N8N_WEBHOOK_URL=
# URL pública del frontend, usada para construir el enlace mágico
PORTAL_URL=http://localhost:5173
# Orígenes del frontend autorizados (CORS), separados por coma
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Frontend (Vite) ──
# También se inserta en el Content-Security-Policy de index.html
VITE_API_URL=http://localhost:3001

# ── Asistente virtual (Claude) ──
# Clave de la API de Anthropic. Solo la usa el servidor (Vite en desarrollo, función de Vercel en producción):
# no lleva prefijo VITE_, así nunca se incluye en el código del navegador. En Vercel, agrégala en
# Settings → Environment Variables. Vacía = el chat avisa que el asistente no está disponible.
ANTHROPIC_API_KEY= 
