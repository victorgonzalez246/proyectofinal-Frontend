{
  "name": "clinica-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:n8n": "vite --mode n8n --port 5173 --strictPort",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env server.js",
    "test": "vitest run",
    "test:unitarias": "vitest run testings/unitarias",
    "test:componentes": "vitest run testings/componentes",
    "test:integracion": "vitest run testings/integracion",
    "test:todo": "node scripts/verificar.mjs && vitest run --reporter=verbose",
    "verificar": "node scripts/verificar.mjs",
    "revisar": "node scripts/revisar-presentacion.mjs",
    "sembrar:demo": "node scripts/sembrar-demo.mjs",
    "exportar:sheets": "node scripts/exportar-sheets.mjs",
    "probar:n8n": "node scripts/probar-n8n.mjs",
    "probar:produccion": "node scripts/probar-produccion.mjs",
    "generar:n8n": "node n8n/generar-api.mjs && node n8n/generar-cerebro.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
