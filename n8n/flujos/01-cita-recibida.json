      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Configuración editable del flujo (nodo \"Configuración\")\nconst cfg = $('Configuración').first().json;\n// WhatsApp exige el número con código de país y sin símbolos (Costa Rica: 506)\nconst toWa = (phone) => {\n  const digits = String(phone || '').replace(/\\D/g, '');\n  return digits.length === 8 ? '506' + digits : digits;\n};\nconst firstName = (name) => String(name || '').trim().split(/\\s+/)[0] || '';\nconst fechaLarga = (iso) =>\n  new Date(String(iso).slice(0, 10) + 'T12:00:00-06:00').toLocaleDateString('es-CR', {\n    weekday: 'long', day: 'numeric', month: 'long', timeZone: 'America/Costa_Rica',\n  });\n// Las variables de plantilla no admiten saltos de línea ni espacios repetidos\nconst clean = (value) => String(value ?? '').replace(/\\s+/g, ' ').trim().slice(0, 900);\nconst msg = (to, template, params) => ({ json: { to: toWa(to), template, params: params.map(clean) } });\n\n  const body = $('Webhook').first().json.body || {};\n  const cita = body.appointment || {};\n  if (body.event !== 'appointment.created' || !cita.telefono) return [];\n\n  const mensajes = [\n    // A la paciente: sin nombrar el tratamiento (discreción) y con acceso a su portal\n    msg(cita.telefono, 'cita_recibida', [firstName(cita.nombre), fechaLarga(cita.fecha), cfg.portalUrl + '/portal/acceso']),\n  ];\n  if (cfg.clinicWhatsapp) {\n    mensajes.push(msg(cfg.clinicWhatsapp, 'nueva_solicitud_cita', [cita.nombre, cita.telefono, cita.tratamiento, fechaLarga(cita.fecha)]));\n  }\n  return mensajes;\n"
      },
      "id": "4486a139-c751-4312-a3fe-78c2477bed17",
      "name": "Preparar mensajes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $('Configuración').first().json.graphApiVersion }}/{{ $('Configuración').first().json.whatsappPhoneNumberId }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.to, type: 'template', template: { name: $json.template, language: { code: $('Configuración').first().json.templateLanguage }, components: [{ type: 'body', parameters: $json.params.map(text => ({ type: 'text', text })) }] } }) }}",
        "options": {}
      },
