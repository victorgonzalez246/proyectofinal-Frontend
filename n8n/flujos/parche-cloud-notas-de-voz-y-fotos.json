        "binaryPropertyName": "data",
        "simplify": true,
        "options": {}
      },
      "id": "0fed82fd-c29d-4369-a03e-b2ac8e41fa3f",
      "name": "Gemini · Transcribir nota de voz",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "position": [
        2460,
        -1320
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "credentials": {
        "googlePalmApi": {
          "name": "Gemini - Aura y WhatsApp"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// La transcripción pasa a ser el mensaje (y queda así en la memoria de la conversación)\nconst item = $('Revisar adjunto').first().json;\nconst p = item.payload;\nconst r = $input.first().json || {};\nconst t = (r.content?.parts || []).filter((x) => !x.thought).map((x) => x.text || '').join(' ').replace(/\\s+/g, ' ').trim();\nif (!t || /^\\[?inaudible\\]?\\.?$/i.test(t)) return [{ json: { ...item, payload: { ...p, tipo: 'medio_fallido' } } }];\nconst contenido = t.slice(0, 1400);\nreturn [{ json: { ...item, payload: { ...p, contenido, texto: '[Nota de voz transcrita] ' + contenido } } }];\n"
      },
      "id": "abda0469-382d-48b9-ab58-1d37e7cfe26d",
      "name": "Texto de la nota de voz",
      "type": "n8n-nodes-base.code",
